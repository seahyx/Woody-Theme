  <export format="csv" delimiter="," quote='"' compress="false">
    <path>/var/lib/woody/exports</path>
    <url>https://inventory.example.com/api/v2/exports?site=SITE-NORTH&amp;format=csv</url>
    <filter><![CDATA[species == "Quercus robur" && dbh_cm > 40 && plot != 'P-003']]></filter>
    <row-template><![CDATA[<tr><td>{tag}</td><td>{species}</td><td>{dbh_cm}</td></tr>]]></row-template>
  </export>

  <footer>Report for &site; &#8212; &licence;. All measurements are metric.</footer>
</inventory>
