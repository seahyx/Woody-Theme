    </plot>
    <plot id="P-002" surveyed="2026-04-13" area-m2="400">
      <tree tag="2001" species="PSME" dbh="72.9" height="38.5" felled="true"/>
      <note>Tree <ref tag="2001"/> was felled for batch <batch-ref>SB-2026-014</batch-ref> after "storm damage".</note>
