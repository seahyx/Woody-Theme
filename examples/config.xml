  <species-list>
    <species code="QURO" native="true">
      <common>English oak</common>
      <latin>Quercus robur</latin>
      <density unit="kg/m&#179;">720</density>
    </species>
    <species code="PISY" native="true">
      <common>Scots pine</common>
      <latin>Pinus sylvestris</latin>
      <density unit="kg/m&#xB3;">550</density>
    </species>
    <species code='PSME' native='false'>
      <common>Douglas fir</common>
      <latin>Pseudotsuga menziesii</latin>
      <density unit="kg/m&#179;">530</density>
    </species>
  </species-list>

  <plots>
    <plot id="P-001" surveyed="2026-04-12" area-m2="400">
      <tree tag="1001" species="QURO" dbh="64.2" height="23.1"/>
      <tree tag="1002" species="PISY" dbh="41.7" height="26.0" felled='false' />
