  <!ENTITY licence "&#169; 2026 Woody Inventory contributors">
]>
<inventory xmlns="https://schemas.example.com/woody/inventory/2"
           xmlns:geo="https://schemas.example.com/woody/geo/1"
           version="2.4.1"
           generated='2026-11-26T08:15:30Z'>
  <site id="SITE-NORTH" certified="true">
    <name>&site;</name>
    <geo:point geo:lat="54.401838" geo:lon="-2.966417" geo:elevation="212.5"/>
    <geo:boundary srs="EPSG:4326">54.41 -2.98 54.39 -2.95</geo:boundary>
    <manager/>
