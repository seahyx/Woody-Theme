# Makefile — build and housekeeping tasks for the fictional woody-inventory service.
# Demonstrates GNU Make syntax: variable flavours, .PHONY, .DEFAULT_GOAL, pattern rules, automatic variables, functions, conditionals, define/endef, recipe prefixes and a self-documenting help target.

# ---- Variables ---------------------------------------------------------------
PROJECT    := woody-inventory
VERSION    ?= $(shell git describe --tags --always 2>/dev/null || echo 0.0.0-dev)
PYTHON     ?= python3
IMAGE       = registry.example.com/woody/inventory-api:$(VERSION)
BUILD_DIR  := build

CC         ?= cc
CFLAGS     := -O2 -Wall -Wextra -std=c11
CFLAGS     += -fPIC
LDFLAGS    += -shared -lm

# Native helpers that count growth rings from core-sample scans
SOURCES    := $(wildcard native/*.c)
OBJECTS    := $(patsubst %.c,%.o,$(SOURCES))
LIBRARY    := $(BUILD_DIR)/libwoodyrings.so

PLOTS      := P-001 P-002 P-003
REPORTS    := $(foreach plot,$(PLOTS),$(BUILD_DIR)/reports/$(plot).csv)

# ---- Conditionals ------------------------------------------------------------
ifeq ($(MODE),debug)
    CFLAGS += -g -O0 -DWOODY_DEBUG=1
else
    CFLAGS += -DNDEBUG
endif

ifdef CI
    PYTEST_ARGS := -q --maxfail=1
else
    PYTEST_ARGS := -ra
endif

# $(if) picks a value inline: add --no-cache only when NO_CACHE is set
DOCKER_FLAGS := $(if $(NO_CACHE),--no-cache,) --build-arg APP_VERSION=$(VERSION)

# A multi-line variable, written out verbatim by the version-file target
define VERSION_PY
# Generated by make; do not edit.
__project__ = "$(PROJECT)"
__version__ = "$(VERSION)"
endef
export VERSION_PY

# ---- Targets -----------------------------------------------------------------
.DEFAULT_GOAL := help
.PHONY: help all native test lint format reports version-file docker clean

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

all: native test ## Build the native helpers and run the tests

native: $(LIBRARY) ## Compile the ring-counting helpers

$(LIBRARY): $(OBJECTS) | $(BUILD_DIR)
	@echo "  LD  $@"
	$(CC) $(LDFLAGS) -o $@ $^

# Pattern rule: $< is the first prerequisite, $* the matched stem
%.o: %.c
	@echo "  CC  $*"
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	@mkdir -p $@

test: ## Run the test suite
	$(PYTHON) -m pytest $(PYTEST_ARGS)

lint: ## Lint the code; type-check failures are reported but do not stop make
	$(PYTHON) -m ruff check .
	-$(PYTHON) -m mypy src

format: ## Format the code in place
	$(PYTHON) -m ruff format .

reports: $(REPORTS) ## Export one CSV per survey plot

$(BUILD_DIR)/reports/%.csv: | $(BUILD_DIR)
	@mkdir -p $(dir $@)
	$(PYTHON) -m woody_inventory.export --plot $* --output $@

version-file: ## Write src/woody_inventory/_version.py
	@echo "$$VERSION_PY" > src/woody_inventory/_version.py

docker: ## Build the container image
	docker build $(DOCKER_FLAGS) -t $(IMAGE) .

clean: ## Remove build artefacts
	-rm -f $(OBJECTS)
	-rm -rf $(BUILD_DIR) .pytest_cache .ruff_cache
