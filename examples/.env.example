# .env.example — environment variables for the fictional woody-inventory service.
# Copy to .env and replace every "change-me" placeholder. Demonstrates dotenv syntax: comments, plain and quoted values, ${VAR} expansion, empty values and export.

# --- Application ---
APP_NAME=woody-inventory
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080
APP_BASE_URL=https://inventory.example.com
APP_SECRET_KEY=change-me

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=woody
DB_USER=woody_app
DB_PASSWORD="change-me"
# Built from the variables above with ${VAR} expansion
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Cache and queue ---
REDIS_URL=redis://:change-me@localhost:6379/0
QUEUE_URL=amqp://woody:change-me@localhost:5672/%2Fwoody

# --- Sensors and grading ---
MOISTURE_ALERT_PCT=19.5
TEMPERATURE_MIN_C=-5
DEFAULT_SPECIES="Quercus robur"
# Single quotes keep ${...} and backslashes literal
GRADING_LABEL='Batch ${BATCH_ID} \ grade ${GRADE}'
REPORT_FOOTER="Woody Inventory\nInternal use only"

# --- Optional integrations (leave empty to disable) ---
SMTP_URL=
ERROR_REPORTING_DSN=https://public-key@errors.example.com/42
MAP_TILES_URL=https://tiles.example.org/{z}/{x}/{y}.png

# Exported so child processes such as the sawmill worker inherit them
export LOG_LEVEL=debug
export PYTHONUNBUFFERED=1
